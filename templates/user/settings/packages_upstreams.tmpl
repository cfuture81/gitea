{{template "user/settings/layout_head" (dict "pageClass" "user settings packages")}}
	<div class="user-setting-content">
		<h4 class="ui top attached header tw-flex tw-items-center tw-justify-between">
			<span>{{svg "octicon-package-dependencies" 16}} Registry upstream proxies</span>
			{{if .Upstreams}}<span class="ui small label">{{len .Upstreams}}</span>{{end}}
		</h4>
		<div class="ui attached segment">
			{{if not .EnableUpstreamProxy}}
				<div class="ui warning message">
					The upstream proxy feature is disabled. Set <code>[packages] ENABLE_UPSTREAM_PROXY = true</code> in app.ini to activate it.
				</div>
			{{end}}
			<p class="tw-mb-2">
				<strong>Pull-through</strong> caches a remote registry on a miss; <strong>frozen</strong> serves only what is already cached and never contacts the upstream.
				Use <strong>pinned tags</strong> to alias a mutable tag (e.g. <code>latest</code>) to a fixed version, so clients keep pulling <code>latest</code> but receive the pinned version (container only).
			</p>
			<div class="ui info message">
				<strong>Freshness &amp; retention.</strong> Pull-through revalidates mutable metadata within the <em>TTL</em> window and negatively caches upstream 404s for the same window (frozen never contacts the upstream). Cached artifacts are ordinary package versions (tagged <code>upstream.cached</code>, shown as <span class="ui blue label">{{svg "octicon-cloud" 12}} proxied</span> in package lists) and are pruned by your
				<a href="{{AppSubUrl}}/user/settings/packages">package cleanup rules</a> — tip: use a dedicated owner/org for proxied content so an age-based rule prunes only the cache, mirroring Nexus per-proxy policies.
			</div>
			{{if .Upstreams}}
			<table class="ui celled compact table">
				<thead>
					<tr>
						<th>Type</th><th>Name</th><th>Upstream URL</th><th>Mode</th>
						<th class="tw-text-center" data-tooltip-content="Resolution priority within a type — lower is tried first">Prio</th>
						<th class="tw-text-center" data-tooltip-content="Metadata revalidation window (seconds)">TTL</th>
						<th class="tw-text-center">Enabled</th>
						<th class="tw-text-center" data-tooltip-content="Fetches from the upstream (cache misses)">Fetches</th>
						<th class="tw-text-center" data-tooltip-content="Served from local cache (hits)">Hits</th>
						<th>Pinned tags</th>
						<th></th>
					</tr>
				</thead>
				<tbody>
					{{range .Upstreams}}
					<tr{{if not .Enabled}} class="tw-opacity-50"{{end}}>
						<td><span class="ui basic label">{{.Type}}</span></td>
						<td class="tw-font-semibold">{{.Name}}</td>
						<td><code>{{.URL}}</code></td>
						<td>{{if eq (printf "%s" .Mode) "frozen"}}<span class="ui grey label" data-tooltip-content="Serves only cached content; never contacts the upstream">{{svg "octicon-lock" 12}} frozen</span>{{else}}<span class="ui teal label" data-tooltip-content="Fetches and caches on a miss">{{svg "octicon-sync" 12}} pull-through</span>{{end}}</td>
						<td class="tw-text-center">{{.Priority}}</td>
						<td class="tw-text-center">{{.MetadataTTL}}s</td>
						<td class="tw-text-center">{{if .Enabled}}<span class="text green" data-tooltip-content="Enabled">{{svg "octicon-check-circle-fill" 16}}</span>{{else}}<span class="text grey" data-tooltip-content="Disabled">{{svg "octicon-circle-slash" 16}}</span>{{end}}</td>
						<td class="tw-text-center">{{.FetchCount}}</td>
						<td class="tw-text-center">{{.HitCount}}</td>
						<td>
							{{if .PinnedTags}}
								{{range .PinnedTags}}<span class="ui small label" data-tooltip-content="{{.Image}}:{{.Tag}} is served as {{.Target}}"><code>{{.Image}}:{{.Tag}}</code> &rarr; <strong>{{.Target}}</strong></span>{{end}}
							{{else}}
								<span class="text grey">—</span>
							{{end}}
						</td>
						<td class="right aligned tw-whitespace-nowrap">
							<a class="ui tiny button" href="{{$.UpstreamsLink}}?id={{.ID}}">{{svg "octicon-pencil" 12}} Edit</a>
							<form class="tw-inline-block" action="{{$.UpstreamsLink}}/{{.ID}}/delete" method="post" onsubmit="return confirm('Delete upstream &quot;{{.Name}}&quot;?')">
								<button class="ui tiny red button">{{svg "octicon-trash" 12}} Delete</button>
							</form>
						</td>
					</tr>
					{{end}}
				</tbody>
			</table>
			{{else}}
				<div class="empty-placeholder tw-py-4">
					{{svg "octicon-package-dependencies" 36}}
					<p>No upstreams configured yet. Add one below to proxy Maven Central, Docker Hub, npm, or PyPI.</p>
				</div>
			{{end}}
		</div>

		{{$e := .EditUpstream}}
		<h4 class="ui top attached header">
			{{if $e}}{{svg "octicon-pencil" 16}} Edit upstream #{{$e.ID}}{{else}}{{svg "octicon-plus" 16}} Add upstream{{end}}
		</h4>
		<div class="ui attached segment">
			<form class="ui form" method="post" action="{{if $e}}{{.UpstreamsLink}}/{{$e.ID}}{{else}}{{.UpstreamsLink}}{{end}}">
				<div class="two fields">
					<div class="field">
						<label>Type</label>
						<select name="type" {{if $e}}disabled{{end}}>
							<option value="maven" {{if and $e (eq (printf "%s" $e.Type) "maven")}}selected{{end}}>maven</option>
							<option value="container" {{if and $e (eq (printf "%s" $e.Type) "container")}}selected{{end}}>container</option>
							<option value="npm" {{if and $e (eq (printf "%s" $e.Type) "npm")}}selected{{end}}>npm</option>
							<option value="pypi" {{if and $e (eq (printf "%s" $e.Type) "pypi")}}selected{{end}}>pypi</option>
						</select>
						{{if $e}}<input type="hidden" name="type" value="{{$e.Type}}">{{end}}
					</div>
					<div class="field">
						<label>Name</label>
						<input name="name" value="{{if $e}}{{$e.Name}}{{end}}" placeholder="e.g. central / dockerhub" required>
					</div>
				</div>
				<div class="field">
					<label>Upstream URL</label>
					<input name="url" value="{{if $e}}{{$e.URL}}{{end}}" placeholder="https://repo1.maven.org/maven2/ or https://registry-1.docker.io" required>
				</div>
				<div class="two fields">
					<div class="field">
						<label>Mode</label>
						<select name="mode">
							<option value="pull_through" {{if and $e (eq (printf "%s" $e.Mode) "pull_through")}}selected{{end}}>pull_through</option>
							<option value="frozen" {{if and $e (eq (printf "%s" $e.Mode) "frozen")}}selected{{end}}>frozen</option>
						</select>
					</div>
					<div class="field">
						<label>Metadata TTL (seconds)</label>
						<input name="metadata_ttl" type="number" value="{{if $e}}{{$e.MetadataTTL}}{{else}}900{{end}}">
					</div>
				</div>
				<div class="two fields">
					<div class="field">
						<label>Priority (lower = tried first within the group)</label>
						<input name="priority" type="number" value="{{if $e}}{{$e.Priority}}{{else}}100{{end}}">
					</div>
					<div class="field"></div>
				</div>
				<div class="three fields">
					<div class="field">
						<label>Auth type</label>
						<select name="auth_type">
							<option value="none" {{if and $e (eq (printf "%s" $e.AuthType) "none")}}selected{{end}}>none</option>
							<option value="basic" {{if and $e (eq (printf "%s" $e.AuthType) "basic")}}selected{{end}}>basic</option>
							<option value="token" {{if and $e (eq (printf "%s" $e.AuthType) "token")}}selected{{end}}>token</option>
						</select>
					</div>
					<div class="field">
						<label>Auth username</label>
						<input name="auth_username" value="{{if $e}}{{$e.AuthUsername}}{{end}}">
					</div>
					<div class="field">
						<label>Auth secret {{if $e}}(leave blank to keep){{end}}</label>
						<input name="auth_secret" type="password" autocomplete="new-password">
					</div>
				</div>
				<div class="field">
					<label class="gt-checkbox">
						<input type="checkbox" name="enabled" value="true" {{if or (not $e) $e.Enabled}}checked{{end}}> Enabled
					</label>
				</div>
				<div class="field">
					<label>Pinned tags (JSON array; container only)</label>
					<textarea name="pinned_tags" rows="4" placeholder='[{"image":"library/mongo","tag":"latest","target":"4.4"}]'>{{if .EditPinnedTagsJSON}}{{.EditPinnedTagsJSON}}{{end}}</textarea>
				</div>
				<button class="ui primary button">{{if $e}}Save changes{{else}}Add upstream{{end}}</button>
				{{if $e}}<a class="ui button" href="{{.UpstreamsLink}}">Cancel</a>{{end}}
			</form>
		</div>
	</div>
{{template "user/settings/layout_footer" .}}
